{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "noFallthroughCasesInSwitch": true,
    "jsx": "react",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@lib/*": ["./src/lib/*"]
    },
    "types": ["react", "react-dom", "node"],
    "skipLibCheck": true,
    "noImplicitAny": false,
    "allowJs": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*", "server/**/*"],
  "exclude": ["node_modules"]
}
